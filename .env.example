# Runtime
NODE_ENV=development
PORT=3000

# Session & Authentik OIDC (Stateless admin-only SSO)
# Generate SESSION_SECRET with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Allowed ONLY outside production (dev / Playwright E2E)
AUTH_DEV_BYPASS=true
AUTHENTIK_ENABLED=true
AUTHENTIK_ISSUER=https://auth.nabster.dev/application/o/sentinel/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Prod: https://sentinel.nabster.dev/auth/callback | Local: http://localhost:3000/auth/callback
AUTHENTIK_REDIRECT_URI=http://localhost:3000/auth/callback
# Comma-separated Authentik groups and/or emails allowed to access Sentinel
AUTHENTIK_ALLOWED_GROUPS=authentik Admins
AUTHENTIK_ALLOWED_EMAILS=

# PostgreSQL
POSTGRES_HOST=sentinel-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sentinel_development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sentinel_development

# GitHub
GITHUB_TOKEN=

# VPS / SSH
VPS_HOST=
VPS_USER=control-panel
VPS_APPS_ROOT=/srv/apps
SSH_KEY_PATH=config/ssh_key/sentinel_control_panel
SSH_KNOWN_HOSTS_PATH=config/ssh_key/known_hosts
SSH_VERIFY_HOST_KEY=always
SSH_CONNECT_TIMEOUT_SECONDS=10
SSH_COMMAND_TIMEOUT_SECONDS=600

# Cron monitoring & Prometheus
CRON_OVERDUE_GRACE_MINUTES=15
CRON_SYNC_STALE_AFTER_MINUTES=15
PROMETHEUS_METRICS_TOKEN=

# Umami Analytics v2
UMAMI_BASE_URL=https://umami.nabster.dev
UMAMI_AUTH_TOKEN=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# Grafana Embed
GRAFANA_BASE_URL=
GRAFANA_DASHBOARD_UID=
GRAFANA_DASHBOARD_SLUG=applications-overview
GRAFANA_VARIABLE_NAME=app
GRAFANA_DEFAULT_THEME=dark
GRAFANA_ORG_ID=1
GRAFANA_DEFAULT_FROM=now-6h
GRAFANA_DEFAULT_TO=now
GRAFANA_DEFAULT_TIMEZONE=browser
GRAFANA_REFRESH=30s
GRAFANA_PANEL_ID=panel-6
GRAFANA_GLOBAL_VARIABLE_VALUE=All
