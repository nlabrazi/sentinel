<section class="mx-auto max-w-7xl space-y-6">
  <nav class="flex flex-wrap items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
    <%= link_to "Deployments", deploys_path, class: "hover:text-gray-900 dark:hover:text-gray-100" %>
    <span>/</span>
    <%= link_to @project.name, @project, class: "hover:text-gray-900 dark:hover:text-gray-100" %>
    <span>/</span>
    <span class="font-semibold text-gray-900 dark:text-gray-200"><%= @deployment.commit_sha.first(7) %></span>
  </nav>

  <header class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow sm:p-6">
    <div class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <p class="text-sm font-semibold text-gray-500 dark:text-gray-400"><%= @project.name %></p>
          <% if @project.kind != "app" %>
            <span class="rounded bg-gray-100 dark:bg-gray-800 px-1.5 py-0.5 text-xs text-gray-600 dark:text-gray-300"><%= @project.kind %></span>
          <% end %>
        </div>
        <h1 class="mt-2 break-words text-2xl font-bold text-gray-900 dark:text-gray-100">
          Deployment
          <%= @deployment.commit_sha.first(7) %>
        </h1>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
          Triggered by
          <span class="font-semibold text-gray-700 dark:text-gray-200"><%= @deployment.triggered_by.presence || "unknown" %></span>
          on
          <%= l(@deployment.created_at, format: :long) %>.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <span
          class="
            inline-flex w-fit items-center gap-1.5 rounded-md px-3 py-1 text-sm font-semibold
            <%= @deployment.success? ? 'bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300' : @deployment.failed? ? 'bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300' %>
          ">
          <% if @deployment.running? %>
            <span class="h-2 w-2 animate-pulse rounded-full bg-cyan-500"></span>
          <% elsif @deployment.success? %>
            <%= fa_icon(:circle_check, class_name: "h-4 w-4") %>
          <% elsif @deployment.failed? %>
            <%= fa_icon(:circle_xmark, class_name: "h-4 w-4") %>
          <% end %>
          <%= @deployment.status %>
        </span>

        <%= button_to deploy_project_path(@project),
            method: :post,
            disabled: @project.deployments.running.exists?,
            data: { turbo_confirm: "Voulez-vous relancer un déploiement pour #{@project.name} ?" },
            class: "inline-flex items-center gap-2 rounded-md bg-cyan-400 px-3.5 py-1.5 text-sm font-semibold text-gray-950 hover:bg-cyan-300 disabled:opacity-50 transition-colors" do %>
          <%= fa_icon(:rocket, class_name: "h-3.5 w-3.5") %>
          <span>Redéployer</span>
        <% end %>
      </div>
    </div>
  </header>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <section
      class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow"
      data-controller="clipboard">
      <div class="flex items-center justify-between border-b border-gray-200 dark:border-gray-800 px-5 py-3.5 bg-gray-50 dark:bg-gray-950/60">
        <div class="flex items-center gap-2">
          <h2 class="text-base font-bold text-gray-900 dark:text-gray-100">Logs</h2>
          <% if @deployment.duration %>
            <span class="text-xs text-gray-500 dark:text-gray-400 font-mono">(<%= @deployment.duration %>s)</span>
          <% end %>
        </div>

        <% if @deployment.log.present? %>
          <div class="flex items-center gap-2">
            <span data-clipboard-target="feedback" class="hidden text-xs font-semibold text-green-600 dark:text-green-400">
              Copié !
            </span>
            <button
              type="button"
              data-action="clipboard#copy"
              class="inline-flex items-center gap-1.5 rounded border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
              title="Copier les logs dans le presse-papiers">
              <%= fa_icon(:copy, class_name: "h-3 w-3") %>
              <span>Copier</span>
            </button>
            <%= link_to "data:text/plain;charset=utf-8,#{ERB::Util.url_encode(@deployment.log)}",
                download: "sentinel-#{@project.slug}-deploy-#{@deployment.commit_sha.first(7)}.log",
                class: "inline-flex items-center gap-1.5 rounded border border-gray-300 dark:border-gray-700 bg-white dark:bg-gray-800 px-2.5 py-1 text-xs font-medium text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors",
                title: "Télécharger les logs en .log" do %>
              <%= fa_icon(:download, class_name: "h-3 w-3") %>
              <span>Télécharger</span>
            <% end %>
          </div>
        <% end %>
      </div>

      <% if @deployment.log.present? %>
        <pre
          data-clipboard-target="source"
          class="max-h-[42rem] overflow-auto whitespace-pre-wrap break-words bg-gray-950 p-5 font-mono text-xs leading-6 text-gray-200 selection:bg-cyan-900 selection:text-white"><%= @deployment.log %></pre>
      <% else %>
        <p class="px-5 py-10 text-sm text-gray-500 dark:text-gray-400 text-center">No logs recorded for this deployment.</p>
      <% end %>
    </section>

    <aside class="space-y-6">
      <section class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow">
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">Details</h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Project</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= link_to @project.name, @project, class: "hover:underline text-cyan-600 dark:text-cyan-400" %>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Commit</dt>
            <dd class="mt-1 flex items-center gap-2 font-mono text-xs text-gray-900 dark:text-gray-100">
              <span class="break-all font-semibold"><%= @deployment.commit_sha %></span>
              <% if @project.repo_url.present? && !@project.github_repo.include?(" ") %>
                <%= link_to "https://github.com/#{@project.github_repo}/commit/#{@deployment.commit_sha}",
                            target: "_blank", rel: "noopener",
                            class: "text-cyan-600 hover:text-cyan-500 dark:text-cyan-400",
                            title: "Voir sur GitHub" do %>
                  <%= fa_icon(:arrow_up_right_from_square, class_name: "h-3.5 w-3.5") %>
                <% end %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Branch</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= @project.branch %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Duration</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= @deployment.duration ? "#{@deployment.duration}s" : "-" %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Triggered by</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= @deployment.triggered_by.presence || "unknown" %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Started</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= l(@deployment.created_at, format: :short) %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Updated</dt>
            <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= l(@deployment.updated_at, format: :short) %></dd>
          </div>
        </dl>
      </section>

      <section class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow">
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">VPS</h2>
        <dl class="mt-5 space-y-4 text-sm">
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Path</dt>
            <dd class="mt-1 break-all font-mono text-xs text-gray-900 dark:text-gray-100"><%= @project.vps_path %></dd>
          </div>
          <div>
            <dt class="text-gray-500 dark:text-gray-400">Deploy script</dt>
            <dd class="mt-1 font-mono text-xs text-gray-900 dark:text-gray-100">deploy.sh</dd>
          </div>
        </dl>
      </section>
    </aside>
  </div>
</section>
