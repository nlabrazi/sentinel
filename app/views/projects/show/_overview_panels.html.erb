<div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
  <div class="space-y-6">
    <section
      class="
        overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow
      ">
      <div class="border-b border-gray-200 dark:border-gray-800 px-5 py-4">
        <%= render "shared/ui/section_header",
        title: "Release status",
        description: "État court de la production.",
        icon: :code_branch,
        title_class: "text-lg" %>
      </div>

      <dl class="grid grid-cols-1 text-sm sm:grid-cols-2">
        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800 sm:border-r">
          <dt class="text-gray-500">Production</dt>
          <dd class="mt-1 font-mono font-semibold text-gray-900 dark:text-gray-100">
            <%= if project.last_commit_deployed.present?
              project.last_commit_deployed.first(7)
            else
              "unknown"
            end %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
          <dt class="text-gray-500"><%= project.branch %></dt>
          <dd class="mt-1 font-mono font-semibold text-gray-900 dark:text-gray-100">
            <%= if project.latest_commit_available.present?
              project.latest_commit_available.first(7)
            else
              "unknown"
            end %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800 sm:border-r">
          <dt class="text-gray-500">Version</dt>
          <dd
            class="mt-1 flex flex-wrap items-center gap-2 font-semibold <%= behind_count.positive? ? 'text-yellow-700 dark:text-yellow-300' : 'text-green-700 dark:text-green-300' %>">
            <span><%= behind_count.positive? ? "#{behind_count} update(s)" : "Up to date" %></span>
            <% if behind_count.positive? && project.github_compare_deploy_url.present? %>
              <%= link_to project.github_compare_deploy_url,
                    target: "_blank",
                    rel: "noopener",
                    class: "inline-flex items-center gap-1 text-xs font-normal text-cyan-600 hover:underline dark:text-cyan-400",
                    title: "Voir les commits non déployés sur GitHub" do %>
                <%= fa_icon(:arrow_up_right_from_square, class_name: "text-[10px]") %>
                Diff prod
              <% end %>
            <% end %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
          <dt class="text-gray-500">Deploy state</dt>
          <dd
            class="mt-1 font-semibold <%= running_deployment ? 'text-yellow-700 dark:text-yellow-300' : 'text-gray-900 dark:text-gray-100' %>">
            <%= running_deployment ? "Running" : "Idle" %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800 sm:border-r">
          <dt class="text-gray-500">Staging branch</dt>
          <dd class="mt-1 font-mono font-semibold text-gray-900 dark:text-gray-100">
            <%= project.staging_branch.presence || "None" %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
          <dt class="text-gray-500">Staging drift</dt>
          <dd class="mt-1 flex flex-wrap items-center gap-2">
            <%= render "shared/ui/badge",
            label: project.staging_sync_label,
            variant: project.staging_sync_tone,
            icon: :code_compare %>
            <% if project.github_compare_staging_url.present? %>
              <%= link_to project.github_compare_staging_url,
                    target: "_blank",
                    rel: "noopener",
                    class: "inline-flex items-center gap-1 text-xs font-medium text-cyan-600 hover:underline dark:text-cyan-400",
                    title: "Comparer staging avec la branche de production sur GitHub" do %>
                <%= fa_icon(:arrow_up_right_from_square, class_name: "text-[10px]") %>
                Diff staging
              <% end %>
            <% end %>
          </dd>
        </div>

        <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800 sm:border-b-0 sm:border-r">
          <dt class="text-gray-500">GitHub sync</dt>
          <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
            <% if project.github_synced_at %>
              <%= time_ago_in_words(project.github_synced_at) %>
              ago
            <% else %>
              Never
            <% end %>
          </dd>
        </div>

        <div class="px-5 py-4">
          <dt class="text-gray-500">Jobs sync</dt>
          <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
            <% if !project.cron_monitoring_enabled? %>
              Disabled
            <% elsif project.cron_synced_at %>
              <%= time_ago_in_words(project.cron_synced_at) %>
              ago
            <% else %>
              Never
            <% end %>
          </dd>
        </div>
      </dl>
    </section>

    <%= render "projects/show/quick_terminal", project: project %>

    <section
      class="
        overflow-hidden rounded-xl border border-gray-200 bg-white shadow dark:border-gray-800
        dark:bg-gray-900
      ">
      <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100"><%= t("projects.analytics.title", default: "Analytics") %></h2>
              <% if project.umami_website_id.present? %>
                <span class="inline-flex items-center gap-1 rounded-full bg-cyan-100 px-2 py-0.5 text-xs font-semibold text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300">
                  Umami
                </span>
              <% end %>
            </div>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400"><%= t("projects.analytics.subtitle", default: "Métriques d'audience Umami (dernières 24h).") %></p>
          </div>

          <div class="flex items-center gap-2">
            <%= button_to refresh_umami_project_path(project),
                method: :post,
                class: "inline-flex cursor-pointer items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors",
                title: t("projects.analytics.sync_button_title", default: "Synchroniser les métriques Umami pour ce projet"),
                aria: { label: t("projects.analytics.sync_button", default: "Sync Umami") } do %>
              <%= fa_icon(:rotate, class_name: "h-3.5 w-3.5 text-cyan-500") %>
              <span><%= t("projects.analytics.sync_button", default: "Sync Umami") %></span>
            <% end %>

            <% umami_url = project.umami_website_id.present? ? "#{ENV.fetch('UMAMI_BASE_URL', 'https://umami.nabster.dev')}/websites/#{project.umami_website_id}" : ENV.fetch('UMAMI_BASE_URL', 'https://umami.nabster.dev') %>
            <%= link_to umami_url,
                target: "_blank",
                rel: "noopener",
                class: "inline-flex items-center gap-1.5 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700 transition-colors",
                title: t("projects.analytics.open_umami_title", default: "Ouvrir dans la console Umami") do %>
              <%= fa_icon(:arrow_up_right_from_square, class_name: "h-3.5 w-3.5 text-gray-400") %>
              <span>Umami</span>
            <% end %>
          </div>
        </div>
      </div>

      <div class="space-y-4 p-5">
        <div class="grid grid-cols-3 gap-3 text-sm">
          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("projects.analytics.visitors_24h", default: "Visiteurs (24h)") %></p>
            <p class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= project.umami_synced_at.present? ? number_with_delimiter(project.umami_visitors_24h || 0) : "—" %>
            </p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("projects.analytics.pageviews_24h", default: "Pages vues") %></p>
            <p class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= project.umami_synced_at.present? ? number_with_delimiter(project.umami_pageviews_24h || 0) : "—" %>
            </p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500 dark:text-gray-400"><%= t("projects.analytics.bounce_rate", default: "Taux de rebond") %></p>
            <p class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= project.umami_synced_at.present? ? "#{project.umami_bounce_rate || 0}%" : "—" %>
            </p>
          </div>
        </div>

        <div class="flex items-center justify-between rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-xs text-gray-500 dark:border-gray-800 dark:bg-gray-950/60 dark:text-gray-400">
          <div class="flex items-center gap-2">
            <%= fa_icon(:clock, class_name: "h-3.5 w-3.5 text-gray-400") %>
            <span>
              <% if project.umami_synced_at.present? %>
                <%= t("projects.analytics.last_update", time: time_ago_in_words(project.umami_synced_at), default: "Dernière mise à jour : il y a %{time}") %>
              <% else %>
                <%= t("projects.analytics.never_synced", default: "Jamais synchronisé") %>
              <% end %>
            </span>
          </div>

          <% if project.umami_sync_error.present? %>
            <span class="truncate text-red-500 dark:text-red-400 max-w-xs" title="<%= project.umami_sync_error %>">
              <%= project.umami_sync_error %>
            </span>
          <% end %>
        </div>
      </div>
    </section>
  </div>

  <div class="space-y-6">
    <% grafana_mapping_missing = project.grafana_app_value.blank? %>

    <section
      class="overflow-hidden rounded-xl border border-gray-200 bg-white shadow dark:border-gray-800 dark:bg-gray-900"
      <% if grafana_embed_url.present? %>
        data-controller="collapsible"
        data-collapsible-storage-key-value="sentinel_project_<%= project.id %>_grafana_open"
        data-collapsible-open-value="true"
      <% end %>>
      <div class="border-b border-gray-200 px-5 py-4 dark:border-gray-800">
        <div class="flex items-center justify-between gap-4">
          <div
            <% if grafana_embed_url.present? %>
              class="flex cursor-pointer select-none items-center gap-2.5"
              data-action="click->collapsible#toggle keydown.enter->collapsible#toggle keydown.space->collapsible#toggle"
              role="button"
              tabindex="0"
              aria-expanded="true"
              data-collapsible-target="trigger"
            <% end %>>
            <% if grafana_embed_url.present? %>
              <span
                class="
                  inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-md
                  border border-gray-200 text-gray-500 transition-transform duration-200
                  dark:border-gray-700 dark:text-gray-400
                "
                data-collapsible-target="icon">
                <%= fa_icon(:chevron_right, class_name: "text-[10px]") %>
              </span>
            <% end %>

            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">Observability</h2>
                <% if grafana_embed_url.present? %>
                  <span
                    class="
                      rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700
                      dark:bg-green-900/40 dark:text-green-300
                    ">Live</span>
                <% elsif grafana_mapping_missing %>
                  <span
                    class="
                      rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-semibold text-yellow-700
                      dark:bg-yellow-900/40 dark:text-yellow-300
                    ">Mapping missing</span>
                <% else %>
                  <span
                    class="
                      rounded-full bg-gray-100 px-2.5 py-0.5 text-xs font-semibold text-gray-500
                      dark:bg-gray-800 dark:text-gray-400
                    ">Not configured</span>
                <% end %>
              </div>
              <p class="mt-0.5 text-sm text-gray-500 dark:text-gray-400">
                <% if grafana_embed_url.present? %>
                  Métriques Grafana du projet (cliquer pour replier ou déplier).
                <% else %>
                  Place prévue pour Grafana.
                <% end %>
              </p>
            </div>
          </div>

          <% if grafana_embed_url.present? %>
            <div class="flex shrink-0 items-center gap-2">
              <button
                type="button"
                class="
                  inline-flex cursor-pointer items-center justify-center gap-1.5 rounded-md border
                  border-gray-300 px-2.5 py-1.5 text-xs font-semibold text-gray-700 transition
                  hover:border-gray-400 hover:bg-gray-100 focus:outline-none focus:ring-1 focus:ring-gray-400
                  dark:border-gray-700 dark:text-gray-200 dark:hover:border-gray-500 dark:hover:bg-gray-800
                "
                data-action="click->collapsible#toggle"
                aria-label="Replier ou déplier le panneau Grafana">
                <%= fa_icon(:chart_line, class_name: "text-[10px] text-gray-500") %>
                <span data-collapsible-target="buttonLabel">Masquer</span>
              </button>

              <%= render "shared/ui/button",
              href: grafana_embed_url,
              label: "Ouvrir",
              icon: :arrow_up_right_from_square,
              variant: :secondary,
              size: :sm,
              target: "_blank",
              rel: "noopener" %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="p-5">
        <div class="grid grid-cols-3 gap-3 text-sm">
          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500">Status</p>
            <p
              class="mt-1 font-semibold <%= project.runtime_status == 'online' ? 'text-green-700 dark:text-green-300' : project.runtime_status == 'offline' ? 'text-red-700 dark:text-red-300' : 'text-gray-600 dark:text-gray-300' %>">
              <%= project.runtime_status_label %>
            </p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500">HTTP</p>
            <p class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= project.runtime_monitoring_enabled? ? (latest_ping&.http_status || "unknown") : "disabled" %>
            </p>
          </div>

          <div class="rounded-lg border border-gray-200 bg-gray-50 px-3 py-3 dark:border-gray-800 dark:bg-gray-950">
            <p class="text-xs text-gray-500">Latency</p>
            <p class="mt-1 font-semibold text-gray-900 dark:text-gray-100">
              <%= project.runtime_monitoring_enabled? ? (latest_ping&.response_time_ms ? "#{latest_ping.response_time_ms}ms" : "unknown") : "disabled" %>
            </p>
          </div>
        </div>

        <% if grafana_embed_url.present? %>
          <div data-collapsible-target="content">
            <div
              class="
                mt-4 overflow-hidden rounded-lg border border-gray-200 bg-gray-950
                dark:border-gray-800
              ">
              <iframe
                class="h-80 w-full border-0"
                src="<%= grafana_embed_url %>"
                title="Grafana dashboard for <%= project.name %>"
                loading="lazy"
                referrerpolicy="no-referrer"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups"></iframe>
            </div>

            <div class="mt-3 flex justify-end">
              <%= render "shared/ui/button",
              href: grafana_embed_url,
              label: "Ouvrir dans Grafana",
              icon: :arrow_up_right_from_square,
              variant: :secondary,
              size: :sm,
              target: "_blank",
              rel: "noopener" %>
            </div>
          </div>
        <% else %>
          <div
            class="
              mt-4 flex h-28 items-center justify-center rounded-lg border border-dashed
              border-gray-300 bg-gray-50 text-center dark:border-gray-700
              dark:bg-gray-950/60
            ">
            <div>
              <p class="text-sm font-semibold text-gray-600 dark:text-gray-300">
                <% if grafana_mapping_missing %>
                  Grafana project mapping missing
                <% else %>
                  Grafana embed not configured
                <% end %>
              </p>
              <p class="mt-1 text-xs text-gray-500">
                <% if grafana_mapping_missing %>
                  Set grafana_app_value for this project.
                <% else %>
                  Set GRAFANA_BASE_URL and GRAFANA_DASHBOARD_UID to display the dashboard.
                <% end %>
              </p>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <section
      class="
        overflow-hidden rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow
      ">
      <div class="border-b border-gray-200 dark:border-gray-800 px-5 py-4">
        <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100">Security</h2>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Points de contrôle simples pour ce projet.</p>
      </div>

      <div class="divide-y divide-gray-200 dark:divide-gray-800 text-sm">
        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="text-gray-500 dark:text-gray-400">HTTPS URL</span>
          <span
            class="font-semibold <%= project.production_url.start_with?('https://') ? 'text-green-700 dark:text-green-300' : 'text-yellow-700 dark:text-yellow-300' %>">
            <%= project.production_url.start_with?("https://") ? "Enabled" : "Check" %>
          </span>
        </div>

        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="text-gray-500 dark:text-gray-400">Maintenance</span>
          <span
            class="font-semibold <%= project.maintenance_mode? ? 'text-yellow-700 dark:text-yellow-300' : 'text-green-700 dark:text-green-300' %>">
            <%= project.maintenance_mode? ? "Enabled" : "Disabled" %>
          </span>
        </div>

        <div class="flex items-center justify-between gap-4 px-5 py-3">
          <span class="text-gray-500 dark:text-gray-400">VPS path</span>
          <span class="font-semibold text-green-700 dark:text-green-300">Restricted</span>
        </div>
      </div>
    </section>
  </div>
</div>
