<section class="mx-auto max-w-7xl space-y-6">
  <% if @running_deployments.any? %>
    <div class="rounded-lg border border-cyan-300/40 bg-cyan-50/70 p-4 dark:border-cyan-800 dark:bg-cyan-950/40">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
          <span class="relative flex h-3 w-3">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cyan-400 opacity-75"></span>
            <span class="relative inline-flex h-3 w-3 rounded-full bg-cyan-500"></span>
          </span>
          <div>
            <p class="text-sm font-bold text-cyan-950 dark:text-cyan-200">
              <%= pluralize(@running_deployments.size, "déploiement en cours", "déploiements en cours") %>
            </p>
            <div class="mt-0.5 flex flex-wrap items-center gap-2 text-xs text-cyan-800 dark:text-cyan-400">
              <% @running_deployments.each do |running| %>
                <span>
                  <strong><%= running.project.name %></strong>
                  (<code class="rounded bg-cyan-100/80 px-1 py-0.5 font-mono dark:bg-cyan-900/60"><%= running.commit_sha.first(7) %></code>)
                  <%= link_to "Voir les logs →", deployment_path(running), class: "underline hover:text-cyan-950 dark:hover:text-white ml-1" %>
                </span>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>

  <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow sm:p-6">
    <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
      <div>
        <h1 class="text-2xl font-bold text-gray-900 dark:text-gray-100">Deployments</h1>
        <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Latest deployment activity across managed projects.</p>
      </div>

      <dl class="grid grid-cols-2 gap-3 text-sm sm:grid-cols-4 lg:min-w-[34rem]">
        <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 px-3 py-2">
          <dt class="text-xs text-gray-500">Total</dt>
          <dd class="mt-1 font-semibold text-gray-900 dark:text-gray-100"><%= @total_deployments_count %></dd>
        </div>
        <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 px-3 py-2">
          <dt class="text-xs text-gray-500">Success</dt>
          <dd class="mt-1 font-semibold text-green-700 dark:text-green-300"><%= @success_deployments_count %></dd>
        </div>
        <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 px-3 py-2">
          <dt class="text-xs text-gray-500">Failed</dt>
          <dd class="mt-1 font-semibold text-red-700 dark:text-red-300"><%= @failed_deployments_count %></dd>
        </div>
        <div class="rounded-md border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-950 px-3 py-2">
          <dt class="text-xs text-gray-500">Taux de succès</dt>
          <dd class="mt-1 font-semibold text-cyan-700 dark:text-cyan-300">
            <%= @success_rate %>%
            <% if @avg_duration.positive? %>
              <span class="text-xs font-normal text-gray-500">(~<%= @avg_duration %>s)</span>
            <% end %>
          </dd>
        </div>
      </dl>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 shadow">
    <%= form_with url: deploys_path, method: :get, class: "flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between" do |f| %>
      <div class="flex flex-1 flex-col gap-3 sm:flex-row sm:items-center">
        <div class="relative flex-1">
          <%= fa_icon(:magnifying_glass, class_name: "absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-gray-400") %>
          <%= f.text_field :q,
              value: params[:q],
              placeholder: "Rechercher par commit SHA ou projet...",
              class: "w-full rounded-md border border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-950 py-1.5 pl-9 pr-3 text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-400 focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400" %>
        </div>

        <div class="w-full sm:w-48">
          <%= f.select :project_id,
              options_from_collection_for_select(@projects, :id, :name, params[:project_id]),
              { include_blank: "Tous les projets" },
              class: "w-full rounded-md border border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-950 py-1.5 px-3 text-sm text-gray-900 dark:text-gray-100 focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400" %>
        </div>

        <div class="w-full sm:w-40">
          <%= f.select :status,
              options_for_select([
                ["Tous statuts", ""],
                ["Running", "running"],
                ["Success", "success"],
                ["Failed", "failed"],
                ["Pending", "pending"]
              ], params[:status]),
              {},
              class: "w-full rounded-md border border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-950 py-1.5 px-3 text-sm text-gray-900 dark:text-gray-100 focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400" %>
        </div>

        <div class="w-full sm:w-28">
          <%= f.select :limit,
              options_for_select([
                ["20 par page", "20"],
                ["50 par page", "50"],
                ["100 par page", "100"]
              ], params[:limit] || "20"),
              {},
              class: "w-full rounded-md border border-gray-300 bg-white dark:border-gray-700 dark:bg-gray-950 py-1.5 px-3 text-sm text-gray-900 dark:text-gray-100 focus:border-cyan-400 focus:outline-none focus:ring-1 focus:ring-cyan-400" %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= f.submit "Filtrer", class: "cursor-pointer rounded-md bg-cyan-400 px-4 py-1.5 text-sm font-semibold text-gray-950 hover:bg-cyan-300 transition-colors" %>
        <% if params[:q].present? || params[:project_id].present? || params[:status].present? || (params[:limit].present? && params[:limit] != "20") %>
          <%= link_to "Réinitialiser", deploys_path, class: "rounded-md border border-gray-300 dark:border-gray-700 px-3 py-1.5 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <section class="overflow-hidden rounded-lg border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 shadow">
    <% if @deployments.any? %>
      <div class="hidden overflow-x-auto md:block">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-800">
          <thead class="bg-gray-50 dark:bg-gray-950">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Project</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Commit</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Status</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Duration</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Déclenché par</th>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase text-gray-500">Date</th>
              <th class="px-6 py-3 text-right text-xs font-semibold uppercase text-gray-500">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 dark:divide-gray-800">
            <% @deployments.each do |deploy| %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/60 transition-colors">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-2">
                    <%= link_to deploy.project.name, deploy.project, class: "text-sm font-semibold text-gray-900 dark:text-gray-100 hover:underline" %>
                    <% if deploy.project.kind != "app" %>
                      <span class="rounded bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600 dark:bg-gray-800 dark:text-gray-300"><%= deploy.project.kind %></span>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <div class="flex items-center gap-1.5 font-mono">
                    <%= link_to deployment_path(deploy), class: "hover:underline", title: "Voir les logs du déploiement" do %>
                      <code class="rounded bg-gray-100 dark:bg-gray-950 px-1.5 py-0.5 text-xs font-medium text-gray-700 dark:text-gray-200">
                        <%= deploy.commit_sha.first(7) %>
                      </code>
                    <% end %>
                    <% if deploy.project.repo_url.present? && !deploy.project.github_repo.include?(" ") %>
                      <%= link_to "https://github.com/#{deploy.project.github_repo}/commit/#{deploy.commit_sha}",
                                  target: "_blank", rel: "noopener",
                                  class: "text-gray-400 hover:text-gray-600 dark:hover:text-gray-200",
                                  title: "Ouvrir le commit sur GitHub" do %>
                        <%= fa_icon(:arrow_up_right_from_square, class_name: "h-3 w-3") %>
                      <% end %>
                    <% end %>
                  </div>
                </td>
                <td class="px-6 py-4">
                  <% if deploy.running? %>
                    <span class="inline-flex items-center gap-1.5 rounded-full bg-cyan-100 px-2.5 py-0.5 text-xs font-semibold text-cyan-800 dark:bg-cyan-900/40 dark:text-cyan-300">
                      <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-cyan-500"></span>
                      running
                    </span>
                  <% elsif deploy.success? %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-800 dark:bg-green-900/40 dark:text-green-300">
                      <%= fa_icon(:circle_check, class_name: "h-3 w-3") %>
                      success
                    </span>
                  <% elsif deploy.failed? %>
                    <span class="inline-flex items-center gap-1 rounded-full bg-red-100 px-2.5 py-0.5 text-xs font-semibold text-red-800 dark:bg-red-900/40 dark:text-red-300">
                      <%= fa_icon(:circle_xmark, class_name: "h-3 w-3") %>
                      failed
                    </span>
                  <% else %>
                    <span class="inline-flex items-center rounded-full bg-yellow-100 px-2.5 py-0.5 text-xs font-semibold text-yellow-800 dark:bg-yellow-900/40 dark:text-yellow-300">
                      pending
                    </span>
                  <% end %>
                </td>
                <td class="px-6 py-4 text-sm text-gray-600 dark:text-gray-300 font-mono">
                  <%= deploy.duration ? "#{deploy.duration}s" : "-" %>
                </td>
                <td class="px-6 py-4 text-xs text-gray-500 dark:text-gray-400">
                  <span class="rounded bg-gray-100 dark:bg-gray-800 px-2 py-0.5 font-medium text-gray-700 dark:text-gray-300">
                    <%= deploy.triggered_by.presence || "web" %>
                  </span>
                </td>
                <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">
                  <span title="<%= l(deploy.created_at, format: :long) %>">
                    <%= l(deploy.created_at, format: :short) %>
                  </span>
                </td>
                <td class="px-6 py-4 text-right text-sm">
                  <%= link_to "Logs →", deployment_path(deploy), class: "font-semibold text-cyan-600 hover:text-cyan-500 dark:text-cyan-400 dark:hover:underline" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <div class="divide-y divide-gray-200 dark:divide-gray-800 md:hidden">
        <% @deployments.each do |deploy| %>
          <article class="space-y-3 p-4">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <h2 class="text-sm font-semibold text-gray-900 dark:text-gray-100">
                  <%= link_to deploy.project.name, deploy.project, class: "hover:underline" %>
                </h2>
                <%= link_to deployment_path(deploy), class: "mt-1 inline-flex hover:underline" do %>
                  <code class="rounded bg-gray-50 dark:bg-gray-950 px-1.5 py-0.5 text-xs text-gray-700 dark:text-gray-200">
                    <%= deploy.commit_sha.first(7) %>
                  </code>
                <% end %>
              </div>
              <span class="text-sm font-semibold <%= deploy.success? ? 'text-green-700 dark:text-green-400' : deploy.failed? ? 'text-red-700 dark:text-red-400' : 'text-yellow-700 dark:text-yellow-300' %>">
                <%= deploy.status %>
              </span>
            </div>
            <dl class="grid grid-cols-2 gap-3 text-sm">
              <div>
                <dt class="text-xs font-semibold uppercase text-gray-500">Duration</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-200"><%= deploy.duration ? "#{deploy.duration}s" : "-" %></dd>
              </div>
              <div>
                <dt class="text-xs font-semibold uppercase text-gray-500">Date</dt>
                <dd class="mt-1 text-gray-700 dark:text-gray-200"><%= l(deploy.created_at, format: :short) %></dd>
              </div>
            </dl>
          </article>
        <% end %>
      </div>

      <% if @total_count > @deployments.size %>
        <div class="border-t border-gray-200 dark:border-gray-800 px-6 py-4 text-center text-xs text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-950/40">
          Affichage de <%= @deployments.size %> sur <%= @total_count %> déploiements.
          <%= link_to "Afficher 50", url_for(request.params.merge(limit: 50)), class: "ml-2 font-semibold text-cyan-600 dark:text-cyan-400 hover:underline" %>
          ou
          <%= link_to "Afficher 100", url_for(request.params.merge(limit: 100)), class: "ml-1 font-semibold text-cyan-600 dark:text-cyan-400 hover:underline" %>
        </div>
      <% end %>
    <% else %>
      <div class="px-6 py-12 text-center">
        <%= fa_icon(:rotate, class_name: "mx-auto h-8 w-8 text-gray-400") %>
        <p class="mt-3 text-sm font-semibold text-gray-900 dark:text-gray-100">Aucun déploiement trouvé</p>
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
          <% if params[:q].present? || params[:project_id].present? || params[:status].present? %>
            Aucun déploiement ne correspond à vos critères de recherche.
          <% else %>
            Aucun historique de déploiement pour le moment.
          <% end %>
        </p>
        <% if params[:q].present? || params[:project_id].present? || params[:status].present? %>
          <div class="mt-4">
            <%= link_to "Réinitialiser les filtres", deploys_path, class: "inline-flex items-center rounded-md bg-cyan-400 px-3 py-1.5 text-xs font-semibold text-gray-950 hover:bg-cyan-300" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </section>
</section>
